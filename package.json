{
  "name": "github-archive",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "tsc --noEmit && ncc build src/start.ts -o build -m",
    "dev": "tsx --watch src/start.ts",
    "start": "tsx src/start.ts",
    "check": "biome check",
    "check:fix": "biome check --write --unsafe --no-errors-on-unmatched",
    "dependency-update": "npm-check-updates -u --filterVersion \"/^[~^<>]| - |\\.x$/\" --deep && pnpm install",
    "generate-schema": "tsx scripts/generate-jobs-schema.ts",
    "test": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.3",
    "nock": "14.0.10",
    "node-cron": "^4.2.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^25",
    "@types/node-cron": "^3.0.11",
    "@vercel/ncc": "^0.38.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-check-updates": "^19.2.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "vitest-mock-extended": "^3.1.0",
    "zx": "^8.8.5"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
